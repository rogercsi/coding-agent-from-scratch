# ── Required ──────────────────────────────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the Anthropic API endpoint (e.g. for a corporate proxy or aiproxy).
# Defaults to the official Anthropic endpoint when unset.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default user identity for long-term memory scoping.
# Memories are keyed per user; use a stable identifier (email, username, etc.).
# AGENT_USER=alice

# Set to true to emit OTel spans to the console (useful for debugging).
# OTEL_CONSOLE=true

# Disable mem0 telemetry (already the default in code; provided for clarity).
# MEM0_TELEMETRY=false
